{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "headers": [
    {
      "source": "/((?!.*\\..*).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/waitlist",
      "destination": "/api/web?op=waitlist"
    },
    {
      "source": "/downloads/:artifact",
      "destination": "/api/downloads/:artifact"
    },
    {
      "source": "/api/updates/:product/:channel/:platform",
      "destination": "/api/updates-feed?product=:product&channel=:channel&platform=:platform"
    },
    {
      "source": "/api/updates/:channel/:platform",
      "destination": "/api/updates-feed?channel=:channel&platform=:platform"
    },
    {
      "source": "/api/web-search",
      "destination": "/api/web?op=search"
    },
    {
      "source": "/api/web-read",
      "destination": "/api/web?op=read"
    },
    {
      "source": "/manu",
      "destination": "/manu/index.html"
    },
    {
      "source": "/manu-s1",
      "destination": "/manu-s1/index.html"
    },
    {
      "source": "/root",
      "destination": "/root/index.html"
    },
    {
      "source": "/root-driver",
      "destination": "/root-driver/index.html"
    },
    {
      "source": "/dhee",
      "destination": "/dhee/index.html"
    },
    {
      "source": "/tura-s1",
      "destination": "/tura-s1/index.html"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-managed-keys",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/chamber",
      "destination": "https://chamber.sankhyaailabs.com/",
      "permanent": true
    }
  ]
}
